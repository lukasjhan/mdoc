{
  "name": "@m-doc/core",
  "description": "mdoc / mDL (ISO/IEC 18013-5 & 18013-7) issuance and verification for TypeScript",
  "license": "Apache-2.0",
  "author": "Lukas J. Han <lukas@hopae.com>",
  "version": "1.0.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        },
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "types:check": "tsc --noEmit",
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "test": "vitest"
  },
  "dependencies": {
    "cbor-x": "^1.6.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@panva/hkdf": "^1.2.1",
    "@peculiar/x509": "^1.14.0",
    "@types/node": "^24.10.0",
    "jose": "^6.1.0",
    "tsdown": "^0.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukasjhan/mdoc.git",
    "directory": "packages/core"
  },
  "keywords": [
    "mdoc",
    "mdl",
    "iso-18013-5",
    "iso-18013-7",
    "cbor",
    "cose",
    "verifiable-credentials",
    "eudi"
  ]
}
